{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quietcast:content-filter:1.0",
  "title": "QuietCast Content Filtering Rules v1.0",
  "description": "任务 A/B 共享接口。评分、优先级与安全正则语义见 content-filter-interface.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ruleVersion",
    "updatedAt",
    "status",
    "sources",
    "categories"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "ruleVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "example",
        "production"
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "fields",
        "note",
        "term"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "showTitle",
              "showDescription",
              "showCategories",
              "author",
              "episodeTitle",
              "episodeDescription",
              "rssMetadata"
            ]
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "fields",
        "note",
        "terms",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "showTitle",
              "showDescription",
              "showCategories",
              "author",
              "episodeTitle",
              "episodeDescription",
              "rssMetadata"
            ]
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "terms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "scope": {
          "enum": [
            "sameField",
            "anyField"
          ]
        }
      }
    },
    "regex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "fields",
        "note",
        "pattern"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "showTitle",
              "showDescription",
              "showCategories",
              "author",
              "episodeTitle",
              "episodeDescription",
              "rssMetadata"
            ]
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "enabled",
        "thresholds",
        "fieldWeights",
        "strongKeywords",
        "keywords",
        "combinationKeywords",
        "exclusions",
        "regexRules",
        "showBlocklist",
        "episodeBlocklist",
        "showAllowlist",
        "episodeAllowlist",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "enabled": {
          "type": "boolean"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review",
            "block"
          ],
          "properties": {
            "review": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "block": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          }
        },
        "fieldWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "showTitle",
            "showDescription",
            "showCategories",
            "author",
            "episodeTitle",
            "episodeDescription",
            "rssMetadata"
          ],
          "properties": {
            "showTitle": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "showDescription": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "showCategories": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "author": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "episodeTitle": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "episodeDescription": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "rssMetadata": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "strongKeywords": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/keyword"
          }
        },
        "keywords": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/keyword"
          }
        },
        "combinationKeywords": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/combination"
          }
        },
        "exclusions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/keyword"
          }
        },
        "regexRules": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/regex"
          }
        },
        "showBlocklist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "episodeBlocklist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "showAllowlist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "episodeAllowlist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
