{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quietcast:content-filter:1.1",
  "title": "QuietCast Content Filtering Rules v1.1 (accepts v1.0)",
  "description": "任务 A/B 共享接口。评分、优先级与安全正则语义见 content-filter-interface.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ruleVersion",
    "updatedAt",
    "status",
    "sources",
    "categories"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "ruleVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "example",
        "production"
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "fields",
        "note",
        "term"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "showTitle",
              "showDescription",
              "showCategories",
              "author",
              "episodeTitle",
              "episodeDescription",
              "rssMetadata"
            ]
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "fields",
        "note",
        "terms",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "showTitle",
              "showDescription",
              "showCategories",
              "author",
              "episodeTitle",
              "episodeDescription",
              "rssMetadata"
            ]
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "terms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "scope": {
          "enum": [
            "sameField",
            "anyField"
          ]
        }
      }
    },
    "regex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "fields",
        "note",
        "pattern"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "showTitle",
              "showDescription",
              "showCategories",
              "author",
              "episodeTitle",
              "episodeDescription",
              "rssMetadata"
            ]
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1000
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "enabled",
        "thresholds",
        "fieldWeights",
        "strongKeywords",
        "keywords",
        "combinationKeywords",
        "exclusions",
        "regexRules",
        "showBlocklist",
        "episodeBlocklist",
        "showAllowlist",
        "episodeAllowlist",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "enabled": {
          "type": "boolean"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "review",
            "block"
          ],
          "properties": {
            "review": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "block": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          }
        },
        "fieldWeights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "showTitle",
            "showDescription",
            "showCategories",
            "author",
            "episodeTitle",
            "episodeDescription",
            "rssMetadata"
          ],
          "properties": {
            "showTitle": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "showDescription": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "showCategories": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "author": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "episodeTitle": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "episodeDescription": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            },
            "rssMetadata": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "strongKeywords": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/keyword"
          }
        },
        "keywords": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/keyword"
          }
        },
        "combinationKeywords": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/combination"
          }
        },
        "exclusions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/keyword"
          }
        },
        "regexRules": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/regex"
          }
        },
        "showBlocklist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "episodeBlocklist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "showAllowlist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "episodeAllowlist": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        },
        "recognition": {
          "$ref": "#/$defs/recognition"
        },
        "classificationRules": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/classificationRule"
          }
        },
        "publisherRules": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/publisherRule"
          }
        }
      }
    },
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appleCategories",
        "publishers",
        "keywords",
        "combination",
        "metadataMaxAgeDays"
      ],
      "properties": {
        "appleCategories": {
          "type": "boolean"
        },
        "publishers": {
          "type": "boolean"
        },
        "keywords": {
          "type": "boolean"
        },
        "combination": {
          "enum": [
            "score",
            "allEnabledSources"
          ]
        },
        "metadataMaxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      }
    },
    "classificationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "match",
        "action",
        "score",
        "note",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ids",
            "names",
            "paths",
            "primaryOnly"
          ],
          "properties": {
            "ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 256,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{1,12}$"
              },
              "uniqueItems": true
            },
            "names": {
              "type": "array",
              "minItems": 0,
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "uniqueItems": true
            },
            "paths": {
              "type": "array",
              "minItems": 0,
              "maxItems": 256,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "uniqueItems": true
              }
            },
            "primaryOnly": {
              "type": "boolean"
            }
          }
        },
        "action": {
          "enum": [
            "score",
            "review",
            "block"
          ]
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true
        }
      }
    },
    "publisherRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "identities",
        "names",
        "role",
        "scope",
        "showIDs",
        "action",
        "score",
        "confirmation",
        "expiresAt",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "identities": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id"
            ],
            "properties": {
              "namespace": {
                "const": "apple.podcasts.artist"
              },
              "id": {
                "type": "string",
                "pattern": "^[0-9]{1,24}$"
              }
            }
          }
        },
        "names": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "role": {
          "enum": [
            "publisher",
            "creator",
            "aggregator",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "allShows",
            "selectedShows"
          ]
        },
        "showIDs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uniqueItems": true
        },
        "action": {
          "enum": [
            "score",
            "review",
            "block"
          ]
        },
        "score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "by",
            "at",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "confirmed",
                "rejected"
              ]
            },
            "by": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "uniqueItems": true
            }
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "categories": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "recognition"
                    ]
                  },
                  {
                    "required": [
                      "classificationRules"
                    ]
                  },
                  {
                    "required": [
                      "publisherRules"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
